# Copie este archivo como .env y ajuste los valores. Nunca suba .env al repositorio.

# Entorno: development | production
NODE_ENV=development

# Puerto HTTP local
PORT=3000

# URL pública usada para construir el enlace de confirmación de correo
BASE_URL=http://localhost:3000

# Secreto para firmar la cookie de sesión. OBLIGATORIO en producción.
# Genere uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=reemplazar-por-un-valor-aleatorio-largo

# Minutos de inactividad antes de que la sesión expire
SESSION_IDLE_MINUTES=30

# Ruta del archivo SQLite
DB_PATH=./data/campusreserva.db

# Zona horaria usada para "hoy" y para la hora actual
APP_TZ=America/Santiago

# Dominio de correo institucional aceptado en el registro (ficticio para la demo)
INSTITUTIONAL_DOMAIN=campus.test

# Días máximos de anticipación para reservar
MAX_DIAS_ANTICIPACION=30

# Intentos de inicio de sesión permitidos por IP cada 15 minutos
LOGIN_MAX_INTENTOS=10

# Buzón de demostración: muestra en pantalla los correos simulados (NO envía correos reales).
# Debe quedar en false en producción.
DEMO_MAILBOX=true

# Carga datos ficticios al iniciar si la base está vacía (solo desarrollo)
SEED_DEMO=true

# Contraseña de las cuentas ficticias creadas por el seed (solo desarrollo)
DEMO_PASSWORD="Demo Campus 2026"

# true si la app corre detrás de un proxy HTTPS (PaaS); habilita cookie Secure correcta
TRUST_PROXY=false
