{
  "name": "campusreserva",
  "version": "1.0.0",
  "description": "MVP web para consultar disponibilidad y reservar salas y laboratorios académicos (Ingeniería de Software TI3043, Evaluación Sumativa 3).",
  "author": "Luis Santiago Chiguay Espinoza",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/server.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "db:reset": "node --env-file-if-exists=.env scripts/init-db.js",
    "test": "node --test --test-reporter=spec \"test/**/*.test.js\"",
    "test:unit": "node --test --test-reporter=spec \"test/unit/*.test.js\"",
    "test:integration": "node --test --test-reporter=spec \"test/integration/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/**/*.js\" \"test/**/*.test.js\"",
    "metricas": "node scripts/carga-concurrente.js",
    "capturas": "node scripts/capturas.js"
  },
  "dependencies": {
    "cookie": "1.1.1",
    "ejs": "3.1.10",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0"
  },
  "devDependencies": {
    "playwright-core": "1.63.0"
  }
}
