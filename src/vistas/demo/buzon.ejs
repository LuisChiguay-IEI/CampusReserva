<%- include('../partials/inicio') %>
<div class="encabezado-pagina">
  <div>
    <h1>Buzón de demostración</h1>
    <p class="subtitulo">Aquí llegan los correos que envía CampusReserva, como el enlace para confirmar una cuenta nueva.</p>
  </div>
</div>

<div class="alerta alerta-aviso" role="note">
  <strong>Correo simulado:</strong> los mensajes no se envían a casillas reales; solo se muestran aquí.
</div>

<% if (correos.length === 0) { %>
  <div class="tarjeta estado-vacio"><h2>No hay correos</h2><p>Registra una cuenta para generar un correo de confirmación.</p></div>
<% } else { %>
  <div class="lista-correos">
    <% correos.forEach((c) => { %>
      <article class="tarjeta correo">
        <header class="correo-cabecera">
          <div>
            <p class="correo-asunto"><%= c.asunto %></p>
            <p class="texto-suave">Para: <%= c.destinatario %></p>
          </div>
          <span class="texto-suave"><%= formatearInstante(c.creado_en) %></span>
        </header>
        <p><%= c.cuerpo %></p>
        <% if (c.enlace) { %>
          <a class="boton boton-primario boton-pequeno" href="<%= c.enlace %>">Abrir enlace de confirmación</a>
        <% } %>
      </article>
    <% }) %>
  </div>
<% } %>
<%- include('../partials/fin') %>
