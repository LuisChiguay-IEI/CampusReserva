<%- include('../partials/inicio') %>
<div class="encabezado-pagina">
  <div>
    <h1>Revisa tu reserva</h1>
    <p class="subtitulo">Verifica los datos antes de confirmar. La disponibilidad se comprueba nuevamente al guardar.</p>
  </div>
</div>

<div class="tarjeta tarjeta-angosta">
  <dl class="resumen">
    <div><dt>Sede</dt><dd><%= espacio.sede_nombre %></dd></div>
    <div><dt>Espacio</dt><dd><%= espacio.nombre %> (<%= tipoLegible(espacio.tipo) %>, <%= espacio.capacidad %> personas)</dd></div>
    <div><dt>Fecha</dt><dd><%= formatearFecha(fecha) %></dd></div>
    <div><dt>Horario</dt><dd><%= horario.hora_inicio %> – <%= horario.hora_fin %></dd></div>
    <div><dt>A nombre de</dt><dd><%= usuario.nombre %> (<%= usuario.correo %>)</dd></div>
  </dl>

  <form method="post" action="/reservas" class="acciones" data-un-envio>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="espacio" value="<%= espacio.id %>">
    <input type="hidden" name="horario" value="<%= horario.id %>">
    <input type="hidden" name="fecha" value="<%= fecha %>">
    <button type="submit" class="boton boton-primario">Confirmar reserva</button>
    <a class="boton boton-secundario" href="/disponibilidad?<%= new URLSearchParams({ sede: espacio.sede_id, fecha }).toString() %>">Volver y cambiar</a>
  </form>
</div>
<%- include('../partials/fin') %>
