<%- include('../partials/inicio') %>
<section class="auth">
  <div class="tarjeta tarjeta-auth">
    <h1>Iniciar sesión</h1>
    <p class="subtitulo">Ingresa con tu correo institucional para consultar y reservar espacios.</p>

    <% if (error) { %>
      <div class="alerta <%= pendiente ? 'alerta-aviso' : 'alerta-error' %>" role="alert">
        <%= error %>
        <% if (pendiente && buzonDemo) { %>
          <br><a href="/demo/buzon">Abrir el Buzón de demostración</a>
        <% } %>
      </div>
    <% } %>

    <form method="post" action="/login" class="formulario" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="campo">
        <label for="correo">Correo institucional</label>
        <input id="correo" name="correo" type="email" autocomplete="username" required maxlength="254"
               value="<%= valores.correo || '' %>" placeholder="nombre@<%= dominioInstitucional %>">
      </div>
      <div class="campo">
        <label for="contrasena">Contraseña</label>
        <input id="contrasena" name="contrasena" type="password" autocomplete="current-password" required maxlength="128">
      </div>
      <button type="submit" class="boton boton-primario boton-bloque">Ingresar</button>
    </form>
    <p class="texto-centrado texto-suave">¿Aún no tienes cuenta? <a href="/registro">Crea tu cuenta</a></p>
  </div>
</section>
<%- include('../partials/fin') %>
